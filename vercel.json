{
  "functions": {
    "api/auth.js": {
      "maxDuration": 15
    },
    "api/agent.js": {
      "maxDuration": 60
    },
    "api/radar.js": {
      "maxDuration": 60
    },
    "api/notify.js": {
      "maxDuration": 30
    },
    "api/cron-radar.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/portal",
      "destination": "/portal.html"
    },
    {
      "source": "/area-logada",
      "destination": "/portal.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-radar",
      "schedule": "30 11 * * *"
    }
  ]
}
